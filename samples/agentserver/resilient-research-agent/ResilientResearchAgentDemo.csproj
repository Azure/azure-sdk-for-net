<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ResilientResearchAgentDemo</AssemblyName>
    <RootNamespace>ResilientResearchAgentDemo</RootNamespace>
    <!-- OpenAI.Responses types (ResponseItem, CreateResponseOptions, StreamingResponse*Update)
         are marked [Experimental] in the OpenAI .NET SDK. Suppress the diagnostic project-wide
         since we intentionally depend on the Responses API for the per-subcall model calls. -->
    <NoWarn>$(NoWarn);OPENAI001</NoWarn>
    <!-- Demo app, not a shipping package. -->
    <IsPackable>false</IsPackable>
    <IsShipping>false</IsShipping>
  </PropertyGroup>

  <!--
    ── SDK reference ─────────────────────────────────────────────────────────
    The Azure.AI.AgentServer.* preview packages are consumed from the public Azure SDK
    dev feed configured in nuget.config — NOT a ProjectReference into azure-sdk-for-net.
    That makes this sample portable: copy it into any repo and it restores unchanged.

    When the packages publish to nuget.org, delete the dev-feed source in nuget.config
    and these resolve from nuget.org with no other change.
  -->
  <ItemGroup>
    <!-- Invocations pulls Core transitively; Core is pinned explicitly because the
         handler/producer use the resilient task + event-stream primitives directly. -->
    <PackageReference Include="Azure.AI.AgentServer.Invocations" Version="1.0.0-beta.6" />
    <PackageReference Include="Azure.AI.AgentServer.Core" Version="1.0.0-beta.27" />
    <!-- Foundry SDK — provides AIProjectClient and ProjectOpenAIClient -->
    <PackageReference Include="Azure.AI.Projects" Version="2.0.1" />
    <!-- OpenAI bridge for Foundry — GetProjectResponsesClientForModel(), CreateResponseOptions, ResponseItem -->
    <PackageReference Include="Azure.AI.Extensions.OpenAI" Version="2.0.0" />
    <!-- Azure authentication — DefaultAzureCredential is provided by Azure.Core
         (Azure.Identity is a type-forwarding shim, so Azure.Core is referenced directly). -->
    <PackageReference Include="Azure.Core" Version="1.58.0" />
  </ItemGroup>

</Project>
