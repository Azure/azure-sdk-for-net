<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RequiredTargetFrameworks>$(RequiredRunnableTargetFrameworks)</RequiredTargetFrameworks>
    <TargetFrameworks>$(RequiredTargetFrameworks)</TargetFrameworks>
    <RootNamespace>Azure.AI.AgentServer.A2A</RootNamespace>
    <Version>1.0.0-beta.1</Version>
    <Description>A2A v1.0 hosting for Microsoft Foundry agents, including native handler integration, task storage, and distributed tracing.</Description>
    <PackageTags>Microsoft Azure AI Agent Server A2A Protocol Handler</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="A2A.AspNetCore" />
    <PackageReference Include="Azure.Core" />
    <PackageReference Include="Azure.Identity" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Azure.AI.AgentServer.Core\src\Azure.AI.AgentServer.Core.csproj" />
  </ItemGroup>
</Project>
