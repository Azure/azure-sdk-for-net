# Foundry project endpoint — auto-injected in hosted containers.
# Set manually for a local run of the REAL research path (LLM subcalls).
# Leave UNSET to use the offline synthetic-token model (USE_FAKE_MODEL is implied
# when FOUNDRY_PROJECT_ENDPOINT is not set) so crash/recover/steer can be exercised
# without credentials.
# FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>

# Model deployment name — must match a deployment in your Foundry project.
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5.4-nano

# Application Insights — auto-injected in hosted containers.
# Set for local telemetry (optional).
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...

# --- Demo tuning (all optional; sensible defaults live in Program.cs / DemoConfig) ---
# DEMO_MODE=1                    # enable the "crash" sentinel message
# USE_FAKE_MODEL=1               # force synthetic tokens even when an endpoint is set
# NUM_PHASES=15
# CALLS_PER_PHASE=4
# TARGET_OUTPUT_TOKENS=1500      # hosted agent.yaml overrides to fit the run window
# INTRA_PHASE_COOLDOWN_SEC=10    # hosted agent.yaml overrides
# INTER_PHASE_COOLDOWN_SEC=20    # hosted agent.yaml overrides
