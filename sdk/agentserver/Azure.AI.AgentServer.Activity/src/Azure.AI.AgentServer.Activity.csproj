<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Server-side ASP.NET Core library — no netstandard2.0 support needed. -->
    <RequiredTargetFrameworks>$(RequiredRunnableTargetFrameworks)</RequiredTargetFrameworks>
    <TargetFrameworks>$(RequiredTargetFrameworks)</TargetFrameworks>
    <RootNamespace>Azure.AI.AgentServer.Activity</RootNamespace>
    <Version>1.0.0-beta.1</Version>
    <Description>An SDK for building ASP.NET Core servers that implement the Azure AI activity protocol, including the Microsoft 365 Agents SDK bridge, session resolution, error-source classification, and distributed tracing.</Description>
    <PackageTags>Microsoft Azure AI Agent Server Activity Protocol Handler</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Nullable>enable</Nullable>
    <DisableEnhancedAnalysis>true</DisableEnhancedAnalysis>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Aliases="AzureIdentity" />
    <PackageReference Include="Microsoft.Agents.Authentication.Msal" />
    <PackageReference Include="Microsoft.Agents.Connector" />
    <PackageReference Include="Microsoft.Agents.Hosting.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Azure.AI.AgentServer.Core\src\Azure.AI.AgentServer.Core.csproj" />
  </ItemGroup>

</Project>
