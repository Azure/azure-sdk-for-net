<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Server-side ASP.NET Core library — no netstandard2.0 support needed. -->
    <RequiredTargetFrameworks>$(RequiredRunnableTargetFrameworks)</RequiredTargetFrameworks>
    <TargetFrameworks>$(RequiredTargetFrameworks)</TargetFrameworks>
    <RootNamespace>Azure.AI.AgentServer.Activity</RootNamespace>
    <Version>1.0.0-beta.1</Version>
    <Description>An SDK for building ASP.NET Core servers that implement the Azure AI activity protocol, including the Microsoft 365 Agents SDK bridge, session resolution, error-source classification, and distributed tracing.</Description>
    <PackageTags>Microsoft Azure AI Agent Server Activity Protocol Handler</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Nullable>enable</Nullable>
    <DisableEnhancedAnalysis>true</DisableEnhancedAnalysis>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Azure.Identity is referenced so the CI project-reference swap
         (UseProjectReferenceToAzureClients=true) resolves it to the repo project
         rather than leaving a transitive NuGet package. The credential types are
         provided by Azure.Core (1.60+); the HideTransitiveAzureIdentity target
         below aliases Azure.Identity away to avoid the CS0433 ambiguity. -->
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Microsoft.Agents.Authentication.Msal" />
    <PackageReference Include="Microsoft.Agents.Connector" />
    <PackageReference Include="Microsoft.Agents.Hosting.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Azure.AI.AgentServer.Core\src\Azure.AI.AgentServer.Core.csproj" />
  </ItemGroup>

  <!--
    Azure.Core 1.60+ defines the credential types (DefaultAzureCredential,
    ManagedIdentityCredential, DefaultAzureCredentialOptions) that older
    Azure.Identity (pulled in transitively by Microsoft.Agents.Authentication.Msal)
    also defines, which causes CS0433 "type exists in both" ambiguity. Hide the
    transitive Azure.Identity behind an extern alias so the unqualified credential
    types resolve to Azure.Core. This runs after reference resolution so it applies
    whether Azure.Identity is a package reference or a project reference (CI builds
    with UseProjectReferenceToAzureClients=true), avoiding the fragile
    PackageReference 'Aliases' metadata that is dropped by the project-ref swap.
  -->
  <Target Name="HideTransitiveAzureIdentity"
          AfterTargets="ResolveReferences"
          BeforeTargets="FindReferenceAssembliesForReferences;CoreCompile">
    <ItemGroup>
      <ReferencePath Condition="'%(FileName)' == 'Azure.Identity'">
        <Aliases>AzureIdentity</Aliases>
      </ReferencePath>
    </ItemGroup>
  </Target>

</Project>
