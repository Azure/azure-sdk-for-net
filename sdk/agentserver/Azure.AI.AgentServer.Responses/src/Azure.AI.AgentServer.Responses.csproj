<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- OPENAI001: the whole OpenAI.Responses surface this package is built on is marked experimental by the OpenAI SDK,
         and the System.ClientModel model-reader generator also emits OpenAI.OpenAIContext references we cannot annotate.
         Removable only once OpenAI drops the tag.
         AAIP002: only two generated sites remain (CreateResponseRequest.Tools, ItemFieldComputerToolCall.Actions assign
         experimental-tagged properties in their own constructors) plus upstream-tagged Extensions items; drop it once
         the spec PR is regenerated and the upstream tags are lifted. -->
    <NoWarn>$(NoWarn);AAIP002;OPENAI001</NoWarn>
    <!-- Server-side ASP.NET Core library — no netstandard2.0 support needed. -->
    <RequiredTargetFrameworks>$(RequiredRunnableTargetFrameworks)</RequiredTargetFrameworks>
    <TargetFrameworks>$(RequiredTargetFrameworks)</TargetFrameworks>
    <RootNamespace>Azure.AI.AgentServer.Responses</RootNamespace>
    <Version>1.0.0-beta.9</Version>
    <Description>An SDK for building ASP.NET Core servers that implement the Azure AI Responses API.</Description>
    <PackageTags>Microsoft Azure AI Agent Server Responses API SSE Streaming</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Nullable>enable</Nullable>
    <DisableEnhancedAnalysis>true</DisableEnhancedAnalysis>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Core" />
    <PackageReference Include="OpenAI" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Azure.AI.AgentServer.Core\src\Azure.AI.AgentServer.Core.csproj" />
    <ProjectReference Include="..\..\..\ai\Azure.AI.Extensions.OpenAI\src\Azure.AI.Extensions.OpenAI.csproj" />
  </ItemGroup>

  <!-- Exclude TypeSpec compilation output (used only for copy to Generated/) -->
  <ItemGroup>
    <Compile Remove="TypeSpec/tsp-output/**" />
    <None Remove="TypeSpec/tsp-output/**" />
  </ItemGroup>

  <!-- Re-include hand-written custom partials (Optional, CodeGenStubs, etc.) -->
  <ItemGroup>
    <Compile Include="TypeSpec/tsp-output/src/Custom/*.cs" />
  </ItemGroup>

</Project>
