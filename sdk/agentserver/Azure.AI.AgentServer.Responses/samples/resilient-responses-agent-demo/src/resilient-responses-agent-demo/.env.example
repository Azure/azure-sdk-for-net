# Foundry project endpoint — auto-injected in hosted containers.
# Only set manually if running without `azd ai agent run` (e.g. the research path locally).
# FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>

# Model deployment name — must match a deployment in your Foundry project.
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5.4-nano

# Application Insights — auto-injected in hosted containers.
# Set for local telemetry (optional but recommended).
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...

# --- Demo tuning (all optional; sensible defaults live in Program.cs / DemoConfig) ---
# DEMO_MODE=1                    # enable crash sentinel + __ECHO_*/__FAIL__/__TASKTRACE__ routes
# NUM_PHASES=15
# CALLS_PER_PHASE=4
# TARGET_OUTPUT_TOKENS=1500      # hosted azure.yaml overrides to 150
# INTRA_PHASE_COOLDOWN_SEC=10    # hosted azure.yaml overrides to 3
# INTER_PHASE_COOLDOWN_SEC=20    # hosted azure.yaml overrides to 3
