<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Hermetic package sources for this sample. `<clear />` drops any inherited
    sources/source-mapping from parent nuget.config files so the sample restores
    identically in this repo and when copied into another repo.

    - agentserver-local: the ".NET package drop" (../packages) — staged from
      sdk/agentserver/packages/ by ./build.sh (see that folder's README.md).
      Provides the unreleased Azure.AI.AgentServer.{Core,Responses} preview.
    - nuget.org: everything else (Azure.AI.Projects, Azure.Identity, etc.).

    When the AgentServer packages publish to nuget.org, delete the local source
    below and everything resolves from nuget.org unchanged.
  -->
  <packageSources>
    <clear />
    <add key="agentserver-local" value="./packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="agentserver-local">
      <package pattern="Azure.AI.AgentServer.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
