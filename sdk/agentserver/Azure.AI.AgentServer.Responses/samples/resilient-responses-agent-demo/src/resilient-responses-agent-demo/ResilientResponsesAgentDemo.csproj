<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ResilientResponsesAgentDemo</AssemblyName>
    <RootNamespace>ResilientResponsesAgentDemo</RootNamespace>
    <!-- OpenAI.Responses types (ResponseItem, CreateResponseOptions, StreamingResponse*Update)
         are marked [Experimental] in the OpenAI .NET SDK. Suppress the diagnostic project-wide
         since we intentionally depend on the Responses API. -->
    <NoWarn>$(NoWarn);OPENAI001</NoWarn>
    <!-- Demo app, not a shipping package. -->
    <IsPackable>false</IsPackable>
    <IsShipping>false</IsShipping>
  </PropertyGroup>

  <!--
    ── SDK reference (the ".NET package drop") ───────────────────────────────
    These are consumed from the local NuGet feed configured in nuget.config
    (../packages, staged from sdk/agentserver/packages/ by ./build.sh) — NOT a
    ProjectReference into azure-sdk-for-net. That makes this sample portable:
    copy it (with the .nupkg drop) into any repo and it restores unchanged.

    The drop ships the unreleased resilient + steerable preview surface. When the
    packages publish to nuget.org, delete the local source in nuget.config and
    these resolve from nuget.org with no other change.
  -->
  <ItemGroup>
    <!-- Responses transitively pulls Core; Core is pinned explicitly because the
         handler/host use resilient primitives directly. -->
    <PackageReference Include="Azure.AI.AgentServer.Responses" Version="1.0.0-beta.7" />
    <PackageReference Include="Azure.AI.AgentServer.Core" Version="1.0.0-beta.27" />
    <!-- Foundry SDK — provides AIProjectClient and ProjectOpenAIClient -->
    <PackageReference Include="Azure.AI.Projects" Version="2.0.1" />
    <!-- OpenAI bridge for Foundry — GetProjectResponsesClientForModel(), CreateResponseOptions, ResponseItem -->
    <PackageReference Include="Azure.AI.Extensions.OpenAI" Version="2.0.0" />
    <!-- Azure authentication via DefaultAzureCredential -->
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
  </ItemGroup>

</Project>
