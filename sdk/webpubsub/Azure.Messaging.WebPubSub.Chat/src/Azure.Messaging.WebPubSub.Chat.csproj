<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>This is the Azure.Messaging.WebPubSub.Chat client library for developing .NET applications with rich experience.</Description>
    <AssemblyTitle>SDK Code Generation Azure.Messaging.WebPubSub.Chat</AssemblyTitle>
    <Version>1.0.0-beta.1</Version>
    <PackageTags>Azure.Messaging.WebPubSub.Chat</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(AzureCoreSharedSources)ExperimentalAttribute.cs" LinkBase="Shared/Core" />
    <Compile Include="$(AzureCoreSharedSources)RawRequestUriBuilder.cs" LinkBase="Shared/Core" />
    <Compile Include="$(AzureCoreSharedSources)TypeFormatters.cs" LinkBase="Shared/Core" />
    <Compile Include="$(AzureCoreSharedSources)RequestHeaderExtensions.cs" LinkBase="Shared/Core" />
    <Compile Include="$(AzureCoreSharedSources)AppContextSwitchHelper.cs" LinkBase="Shared/Core" />
    <Compile Include="$(AzureCoreSharedSources)ClientDiagnostics.cs" LinkBase="Shared/Core" />
    <Compile Include="$(AzureCoreSharedSources)DiagnosticScopeFactory.cs" LinkBase="Shared/Core" />
    <Compile Include="$(AzureCoreSharedSources)DiagnosticScope.cs" LinkBase="Shared/Core" />
    <Compile Include="$(AzureCoreSharedSources)HttpMessageSanitizer.cs" LinkBase="Shared/Core" />
    <Compile Include="$(AzureCoreSharedSources)TrimmingAttribute.cs" LinkBase="Shared/Core" />
    <!--
      Shared source linked from the sibling Azure.Messaging.WebPubSub package's src/Shared folder.
      Those files are the single source of truth (owned by Azure.Messaging.WebPubSub) and are
      compiled into this package so the AzureKeyCredential auth flow stays identical between the two
      clients. Do NOT copy/fork these files - edit them in Azure.Messaging.WebPubSub/src/Shared and
      both packages pick up the change. (Linked rather than exposed via InternalsVisibleTo to avoid AZC0011.)
    -->
    <Compile Include="..\..\Azure.Messaging.WebPubSub\src\Shared\WebPubSubAuthenticationPolicy.cs" LinkBase="Shared/WebPubSub" />
    <Compile Include="..\..\Azure.Messaging.WebPubSub\src\Shared\ReverseProxyPolicy.cs" LinkBase="Shared/WebPubSub" />
    <Compile Include="..\..\Azure.Messaging.WebPubSub\src\Shared\JwtBuilder.cs" LinkBase="Shared/WebPubSub" />
    <Compile Include="..\..\Azure.Messaging.WebPubSub\src\Shared\WebPubSubClientAccessTokenGenerator.cs" LinkBase="Shared/WebPubSub" />
    <Compile Include="..\..\Azure.Messaging.WebPubSub\src\Shared\NS2Bridge.cs" LinkBase="Shared/WebPubSub" />
    <Compile Include="..\..\Azure.Messaging.WebPubSub\src\Shared\ConnectionStringParser.cs" LinkBase="Shared/WebPubSub" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Core" />
  </ItemGroup>
</Project>
