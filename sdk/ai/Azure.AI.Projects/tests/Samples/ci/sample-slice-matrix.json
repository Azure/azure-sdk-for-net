{
  "displayNames": {
    "/p:UseProjectReferenceToAzureClients=false": "PackageRef"
  },
  "matrix": {
    "Agent": {
      "Ubuntu-24.04_NET10.0": {
        "OSVmImage": "env:LINUXVMIMAGE",
        "Pool": "env:LINUXPOOL",
        "TestTargetFramework": "net10.0"
      }
    },
    "BuildConfiguration": [
      "Debug"
    ],
    "AdditionalTestArguments": [
      "/p:UseProjectReferenceToAzureClients=false"
    ],
    "SampleSelector": {
      "ProjectsAuthenticate": {
        "AdditionalTestFilters": "((FullyQualifiedName~Azure.AI.Projects.Tests.Samples & Name=Authenticate & Name!=Troubleshooting))"
      },
      "AgentsVersionSelection": {
        "AdditionalTestFilters": "((FullyQualifiedName~Azure.AI.Projects.Agents.Tests.Samples & Name=VersionSelection & Name!=AgentCRUDAsync & Name!=AgentCRUD & Name!=ErrorHandling))"
      },
      "OpenAIClientCreation": {
        "AdditionalTestFilters": "((FullyQualifiedName~Azure.AI.Extensions.OpenAI.Tests.Samples & Name=CreateAgentClientFromProjectsClient & Name!=CreateAgentClientDirectlyFromProjectEndpoint & Name!=GetOpenAIClientsFromAgents & Name!=SelectClientVersion))"
      }
    }
  }
}
