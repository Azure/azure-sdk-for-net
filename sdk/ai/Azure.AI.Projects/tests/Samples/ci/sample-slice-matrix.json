{
  "displayNames": {
    "/p:UseProjectReferenceToAzureClients=false": "PackageRef"
  },
  "matrix": {
    "Agent": {
      "Ubuntu-24.04_NET10.0": {
        "OSVmImage": "env:LINUXVMIMAGE",
        "Pool": "env:LINUXPOOL",
        "TestTargetFramework": "net10.0"
      }
    },
    "BuildConfiguration": [
      "Debug"
    ],
    "AdditionalTestArguments": [
      "/p:UseProjectReferenceToAzureClients=false"
    ],
    "SampleSelector": {
      "ProjectsClassicAgents": {
        "SampleQueueName": "q1",
        "SampleSliceFilter": "((FullyQualifiedName~Azure.AI.Projects.Tests.Samples & FullyQualifiedName~False & ((FullyQualifiedName~Sample_AIAgents & Name=AgentsBasics)|(FullyQualifiedName~Sample_Deployment & Name=DeploymentExample))))"
      },
      "AgentsVersionSelection": {
        "SampleQueueName": "q2",
        "SampleSliceFilter": "((FullyQualifiedName~Azure.AI.Projects.Agents.Tests.Samples.Sample_agents_CRUD & (Name=VersionSelection|Name=AgentCRUD) & FullyQualifiedName~False))"
      },
      "OpenAIResponseBasic": {
        "SampleQueueName": "q3",
        "SampleSliceFilter": "((FullyQualifiedName~Azure.AI.Extensions.OpenAI.Tests.Samples.Sample_ResponseBasic & Name=AgentResponseSync & FullyQualifiedName~False))"
      },
      "OpenAIResponseStreaming": {
        "SampleQueueName": "q4",
        "SampleSliceFilter": "((FullyQualifiedName~Azure.AI.Extensions.OpenAI.Tests.Samples.Sample_ResponseStreaming & Name=AgentResponseStreamingSync & FullyQualifiedName~False))"
      }
    }
  }
}
