{
  "displayNames": {
    "/p:UseProjectReferenceToAzureClients=false": "PackageRef"
  },
  "matrix": {
    "Agent": {
      "Ubuntu-24.04_NET10.0": {
        "OSVmImage": "env:LINUXVMIMAGE",
        "Pool": "env:LINUXPOOL",
        "TestTargetFramework": "net10.0"
      }
    },
    "BuildConfiguration": [
      "Debug"
    ],
    "AdditionalTestArguments": [
      "/p:UseProjectReferenceToAzureClients=false"
    ],
    "SampleSelector": {
      "ProjectsClientInit": {
        "AdditionalTestFilters": "((FullyQualifiedName~Azure.AI.Projects.Tests.Samples.Sample_ClientInitialization & Name=CreateClientOnly))"
      },
      "AgentsClientInit": {
        "AdditionalTestFilters": "((FullyQualifiedName~Azure.AI.Projects.Agents.Tests.Samples.Sample_ClientInitialization & Name=CreateClientOnly))"
      },
      "OpenAIClientInit": {
        "AdditionalTestFilters": "((FullyQualifiedName~Azure.AI.Extensions.OpenAI.Tests.Samples.Sample_ClientInitialization & Name=CreateClientOnly))"
      }
    }
  }
}
