# Azure.Search.Documents recordings against EXISTING, dedicated test resources.
# Copy to .env in this package directory; replace the placeholders.
# Tests create/delete indexes, indexers, skillsets, knowledge bases and blobs,
# consume capacity, and may incur costs. Do not point them at production.
#
# Common prerequisites (GA and preview):
# - PowerShell 7.5+, repository .NET SDK, Azure CLI.
# - az login --tenant <tenant-id> as the identity running the tests.
# - Search service must support API version 2026-10-01 and allow RBAC auth.
# - Runner roles: Search Service Contributor and Search Index Data Contributor
#   on the Search service; Storage Blob Data Contributor on the storage account.
# - Enable the Search service's SYSTEM-ASSIGNED managed identity.
# - File knowledge source uploads go directly through the runner's Search
#   client and do not require a Storage role.
# - Search identity roles: Cognitive Services OpenAI User on the OpenAI
#   resource for the GPT and embedding deployments; Storage Blob Data Reader for blob sources;
#   Storage Blob Data Contributor for knowledge store blob projections;
#   Storage Table Data Contributor if table projections are exercised.
# - For AI Services-backed skills, grant the Search identity Cognitive Services
#   User on the AI Services resource.
# - For customer-managed encryption, grant the Search identity Key Vault Crypto
#   Service Encryption User and the runner Key Vault Crypto Officer on the vault.
# - Permit network/firewall access from BOTH the runner and Search service.
# - Wait for role assignments to propagate before recording.
#
# Runner uses Azure CLI credentials; Search uses its own identity for outbound
# Storage/OpenAI calls. Neither identity can impersonate the other.
# No provisioning, role assignment, key lookup, or deployment validation is done.
#
# NAME=value only. Full-line comments and matching quotes are supported.
# No inline comments or variable interpolation. Do not commit real tokens.
# SEARCH_ service prefixes override stale encrypted test-resources.*.env files;
# doubled SEARCH_SEARCH_ below is intentional (prefix + Search variable name).

# ============================================================================
# COMMON: test runner and authentication
# ============================================================================
AZURE_TEST_MODE=Record
AZURE_DISABLE_BOOTSTRAPPING=true
AZURE_DISABLE_AUTO_RECORDING=true

SEARCH_SEARCH_SERVICE_NAME=your-search-service
SEARCH_TENANT_ID=your-tenant-id
SEARCH_SEARCH_ENDPOINT_SUFFIX=search.windows.net
SEARCH_ENVIRONMENT=AzureCloud

# All live/recorded tests and samples use RBAC, including batching.
# Existing LiveOnly/PlaybackOnly/Ignore restrictions remain unchanged.
SEARCH_RECORDING_TEST_FILTER=FullyQualifiedName~Azure.Search.Documents.Tests


# GA blob/indexer/knowledge store tests; not required for basic Search CRUD.
SEARCH_SEARCH_STORAGE_NAME=yourstorageaccount
SEARCH_SEARCH_STORAGE_RESOURCE_ID=/subscriptions/your-subscription-id/resourceGroups/your-resource-group/providers/Microsoft.Storage/storageAccounts/yourstorageaccount
SEARCH_STORAGE_ENDPOINT_SUFFIX=core.windows.net

# GA OpenAI-backed knowledge retrieval / embedding skill tests:
# - Deploy gpt-5.4-mini for shared knowledge retrieval.
# - Deploy text-embedding-3-large for embedding skills.
# - Deploy text-embedding-ada-002 for multi vector scenario samples.
# - Deployment names must match those in the selected test.
# - Enable semantic ranking for semantic/knowledge retrieval scenarios.
# These are test dependencies, not a statement of the model's release status.
# PlaybackOnly tests cannot be recorded even with these deployments.
# API keys are omitted in keyless mode.
SEARCH_OPENAI_ENDPOINT=https://your-openai-resource.openai.azure.com/
# GA AI Services endpoint; fill in only if required by selected skill tests.
SEARCH_SEARCH_COGNITIVE_ENDPOINT=

# ============================================================================
# OPTIONAL: CreateDoubleEncryptedIndex (explicit opt-in; existing resources only)
# ============================================================================
# See tests/README.md#customer-managed-encryption-test for the role/scope table,
# vault configuration, networking, cleanup, and the targeted recording command.
# The fixture uses V2024_07_01; override AZURE_LIVE_TEST_SERVICE_VERSIONS to that
# value when recording this test. Do not change the GA selector for other tests.
# Live/Record creates and deletes a key, index, container, data source and indexer.
# Key cleanup is soft-delete only; purge protection retains the deleted key.
SEARCH_RUN_DOUBLE_ENCRYPTED_INDEX=false
SEARCH_SEARCH_KEYVAULT_URL=

# ============================================================================
# PREVIEW ONLY: Fabric Ontology / Fabric Data Agent / Work IQ knowledge sources
# NOT required for GA recordings; leave these values empty for 2026-10-01.
# ============================================================================
# These source types were introduced in 2026-05-01-preview and are excluded
# from 2026-10-01 GA in the TypeSpec. A workspace ID is a dependency of the
# preview Fabric sources, not a separate GA Search feature.
#
# To exercise them, use an SDK/test fixture supporting a preview API version
# that includes these sources, plus the corresponding Fabric resources and
# permissions. Populating these values does NOT enable preview in a GA SDK;
# the version selector above only narrows versions already in the fixture.
#
# Query-source authorization is for external-source scenarios such as
# Fabric/Work IQ. It may require a user token; the Search system identity
# does not replace this user authorization.
# Empty assignments also mask stale values from previous configurations.
SEARCH_SEARCH_QUERY_SOURCE_AUTH=
SEARCH_SEARCH_FABRIC_WORKSPACE_ID=
SEARCH_SEARCH_FABRIC_ONTOLOGY_ID=
SEARCH_SEARCH_FABRIC_DATA_AGENT_ID=
