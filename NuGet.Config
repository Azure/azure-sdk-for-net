<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- LOCAL DEV ONLY: consume locally packed nupkgs from artifacts\packages\Release.
         This change is kept out of git (and therefore CI) via `git update-index skip-worktree NuGet.Config`. -->
    <add key="local-dev" value="C:\Users\nirovins\eclipse-workspace\azure-sdk-for-net\artifacts\packages\Release" />
    <!-- Do not add any additional feeds if new packages are needed they need to come from our azure-sdk-for-net DevOps feed which has an upstream set to nuget.org -->
    <add key="azure-sdk-for-net" value="https://pkgs.dev.azure.com/azure-sdk/public/_packaging/azure-sdk-for-net/nuget/v3/index.json" />
  </packageSources>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
</configuration>
