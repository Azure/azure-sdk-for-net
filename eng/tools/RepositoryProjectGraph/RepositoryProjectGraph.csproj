<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>RepositoryProjectGraph</AssemblyName>
    <RootNamespace>Azure.Sdk.Tools.RepositoryProjectGraph</RootNamespace>
    <!-- This task binds to the invoking SDK's MSBuild assemblies and does not require NuGet restore. -->
    <RestoreProjectStyle>None</RestoreProjectStyle>
    <EnableDefaultItems>false</EnableDefaultItems>
    <SkipResolvePackageAssets>true</SkipResolvePackageAssets>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="CreateSparseCheckoutGraphTask.cs" />
    <Compile Include="RepositoryProjectGraphRecord.cs" />
    <Compile Include="RepositoryProjectGraphTask.cs" />
    <Compile Include="ResolveExternalPackageClosureWithNuGetTask.cs" />
    <Compile Include="RunIsolatedRepositoryProjectGraphTask.cs" />
    <Reference Include="Microsoft.Build"
               HintPath="$(MSBuildToolsPath)/Microsoft.Build.dll"
               Private="false" />
    <Reference Include="Microsoft.Build.Framework"
               HintPath="$(MSBuildToolsPath)/Microsoft.Build.Framework.dll"
               Private="false" />
    <Reference Include="Microsoft.Build.Utilities.Core"
               HintPath="$(MSBuildToolsPath)/Microsoft.Build.Utilities.Core.dll"
               Private="false" />
    <Reference Include="NuGet.Common"
               HintPath="$(MSBuildToolsPath)/NuGet.Common.dll"
               Private="false" />
    <Reference Include="NuGet.Configuration"
               HintPath="$(MSBuildToolsPath)/NuGet.Configuration.dll"
               Private="false" />
    <Reference Include="NuGet.Commands"
               HintPath="$(MSBuildToolsPath)/NuGet.Commands.dll"
               Private="false" />
    <Reference Include="NuGet.DependencyResolver.Core"
               HintPath="$(MSBuildToolsPath)/NuGet.DependencyResolver.Core.dll"
               Private="false" />
    <Reference Include="NuGet.Frameworks"
               HintPath="$(MSBuildToolsPath)/NuGet.Frameworks.dll"
               Private="false" />
    <Reference Include="NuGet.LibraryModel"
               HintPath="$(MSBuildToolsPath)/NuGet.LibraryModel.dll"
               Private="false" />
    <Reference Include="NuGet.Packaging"
               HintPath="$(MSBuildToolsPath)/NuGet.Packaging.dll"
               Private="false" />
    <Reference Include="NuGet.ProjectModel"
               HintPath="$(MSBuildToolsPath)/NuGet.ProjectModel.dll"
               Private="false" />
    <Reference Include="NuGet.Protocol"
               HintPath="$(MSBuildToolsPath)/NuGet.Protocol.dll"
               Private="false" />
    <Reference Include="NuGet.Versioning"
               HintPath="$(MSBuildToolsPath)/NuGet.Versioning.dll"
               Private="false" />
  </ItemGroup>

  <UsingTask TaskName="Azure.Sdk.Tools.RepositoryProjectGraph.CreateSparseCheckoutGraphTask"
             AssemblyFile="$(TargetPath)" />

  <Target Name="CreateSparseCheckoutGraph" DependsOnTargets="Build">
    <CreateSparseCheckoutGraphTask PackageInfoDirectory="$(SparseCheckoutPackageInfoDirectory)"
                                   RepoRoot="$(SparseCheckoutRepoRoot)"
                                   GraphPath="$(SparseCheckoutSourceGraphPath)"
                                   OutputPath="$(SparseCheckoutOutputPath)"
                                   SourceCommit="$(SparseCheckoutSourceCommit)"
                                   AllowDirtySource="$(SparseCheckoutAllowDirtySource)" />
  </Target>
</Project>
