{
  "name": "@azure-typespec/mcp-tools",
  "type": "module",
  "main": "emitter/index.js",
  "tspMain": "lib/main.tsp",
  "exports": {
    ".": {
      "typespec": "./lib/main.tsp",
      "default": "./emitter/index.js"
    }
  },
  "private": true,
  "version": "0.0.0",
  "description": "Service-neutral Azure MCP tool generator using the TypeSpec C# generator providers.",
  "scripts": {
    "build": "node --check emitter/index.js && dotnet build generator/Microsoft.TypeSpec.Generator.Mcp/src/Microsoft.TypeSpec.Generator.Mcp.csproj --configuration Release",
    "test": "dotnet test generator/Microsoft.TypeSpec.Generator.Mcp/test/Microsoft.TypeSpec.Generator.Mcp.Tests.csproj --configuration Release"
  },
  "devDependencies": {
    "@azure-tools/typespec-client-generator-core": "0.73.0",
    "@typespec/compiler": "1.17.0",
    "@typespec/http": "1.17.0",
    "@typespec/http-client-csharp": "1.0.0-alpha.20261014.5"
  }
}
