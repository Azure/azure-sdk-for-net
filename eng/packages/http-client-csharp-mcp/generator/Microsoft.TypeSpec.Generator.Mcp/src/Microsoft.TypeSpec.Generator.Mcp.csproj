<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <GeneratorDirectory>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\..\node_modules\@typespec\http-client-csharp\dist\generator'))</GeneratorDirectory>
    <ManagementGeneratorDirectory>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\..\node_modules\@azure-typespec\http-client-csharp-mgmt\dist\generator'))</ManagementGeneratorDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Microsoft.TypeSpec.Generator" HintPath="$(GeneratorDirectory)\Microsoft.TypeSpec.Generator.dll" />
    <Reference Include="Microsoft.TypeSpec.Generator.Input" HintPath="$(GeneratorDirectory)\Microsoft.TypeSpec.Generator.Input.dll" />
    <Reference Include="System.ComponentModel.Composition" HintPath="$(GeneratorDirectory)\System.ComponentModel.Composition.dll" />
    <Reference Include="Microsoft.CodeAnalysis" HintPath="$(GeneratorDirectory)\Microsoft.CodeAnalysis.dll" />
    <Reference Include="Microsoft.CodeAnalysis.CSharp" HintPath="$(GeneratorDirectory)\Microsoft.CodeAnalysis.CSharp.dll" />
    <Reference Include="System.Memory.Data" HintPath="$(GeneratorDirectory)\System.Memory.Data.dll" />
    <Reference Include="Azure.Generator.Management" HintPath="$(ManagementGeneratorDirectory)\Azure.Generator.Management.dll" />
    <Reference Include="Azure.Generator" HintPath="$(ManagementGeneratorDirectory)\Azure.Generator.dll" />
    <Reference Include="Microsoft.TypeSpec.Generator.ClientModel" HintPath="$(ManagementGeneratorDirectory)\Microsoft.TypeSpec.Generator.ClientModel.dll" />
    <Reference Include="Azure.Core" HintPath="$(ManagementGeneratorDirectory)\Azure.Core.dll" />
    <Reference Include="Azure.ResourceManager" HintPath="$(ManagementGeneratorDirectory)\Azure.ResourceManager.dll" />
    <Reference Include="System.ClientModel" HintPath="$(ManagementGeneratorDirectory)\System.ClientModel.dll" />
    <EmbeddedResource Include="ArmToolPageToken.cs" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Microsoft.TypeSpec.Generator.Mcp.Tests" Key="" />
  </ItemGroup>
  <Target Name="CheckEmitterDependencies" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(GeneratorDirectory)\Microsoft.TypeSpec.Generator.dll')"
           Text="Run npm ci in eng/packages/http-client-csharp-mcp before building the MCP generator." />
  </Target>
  <Target Name="CopyForNpmPackage" AfterTargets="Build">
    <ItemGroup>
      <SourceDir Include="$(GeneratorDirectory)\**\*.*" />
      <ManagementSourceDir Include="$(ManagementGeneratorDirectory)\*.dll;$(ManagementGeneratorDirectory)\*.json" />
      <ManagementSharedSource Include="$(ManagementGeneratorDirectory)\Shared\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(SourceDir)" DestinationFolder="$(MSBuildThisFileDirectory)..\..\..\dist\generator\%(RecursiveDir)" />
    <Copy SourceFiles="@(ManagementSourceDir)" DestinationFolder="$(MSBuildThisFileDirectory)..\..\..\dist\generator\%(RecursiveDir)" />
    <Copy SourceFiles="@(ManagementSharedSource)" DestinationFolder="$(MSBuildThisFileDirectory)..\..\..\dist\generator\Shared\%(RecursiveDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(MSBuildThisFileDirectory)..\..\..\dist\generator" />
  </Target>
</Project>
